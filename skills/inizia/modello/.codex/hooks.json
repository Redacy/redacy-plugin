{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/ferma.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/controlla-periodo.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ]
  }
}
